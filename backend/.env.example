# DATA_SOURCE=yahoo needs no signup at all (Yahoo Finance public gold futures data,
# read-only, no order placement). Good for demoing the live chart right away.
# DATA_SOURCE=oanda is the real path: real demo order placement, needs an OANDA
# v20 Practice account (free) -> My Account -> Manage API Access -> Generate
# Personal Access Token.
# DATA_SOURCE=mt5 attaches to a MetaTrader 5 terminal already running and logged
# in on this machine (demo or live account) — see MT5_* below.
DATA_SOURCE=oanda

OANDA_API_TOKEN=your-personal-access-token-here
OANDA_ACCOUNT_ID=101-004-xxxxxxx-001
OANDA_ENVIRONMENT=practice
INSTRUMENT=XAU_USD
ALLOW_LIVE_TRADING=false
CORS_ORIGINS=["http://localhost:5173"]

# EXECUTION_MODE=simulated (default) — bot decisions always fill against the
# built-in paper-trading engine, regardless of DATA_SOURCE. Set to "live" to
# have the bot place REAL orders through DATA_SOURCE's broker (oanda or mt5
# only) — on a demo account this is real demo trading; on a live account this
# is real money (and also requires ALLOW_LIVE_TRADING=true, checked by the
# broker adapter itself).
EXECUTION_MODE=simulated

# DATA_SOURCE=mt5 — no signup needed here, but the MT5 terminal app must be
# installed, running, and logged in (demo or live) on this machine. If
# MT5_LOGIN is left at 0, the adapter just attaches to whatever account is
# already logged into the running terminal — fill MT5_LOGIN/PASSWORD/SERVER
# only if you want the adapter to switch accounts itself.
MT5_SYMBOL=XAUUSD
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# From platform.openai.com/api-keys — needed for the "ask the bot" chat feature.
OPENAI_API_KEY=your-openai-api-key-here
